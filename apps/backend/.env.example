# ===================================================================
# Nechto Telegram Game - Environment Configuration Template
# ===================================================================

# PostgreSQL Database Configuration
POSTGRES_USER=nechto_user
POSTGRES_PASSWORD=nechto_secret_password
POSTGRES_DB=nechto_db
POSTGRES_PORT=5432

# Application Configuration
SERVER_PORT=8080
TELEGRAM_BOT_USERNAME=StayAwayGameBot

# Comma-separated list of frontend origins allowed to call /api/** (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Optional direct connection overrides
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nechto_db
DB_USER=nechto_user
DB_PASSWORD=nechto_secret_password
